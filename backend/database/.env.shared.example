# Ambiente compartilhado do grupo.
# Nao commitar .env real com senha. Compartilhar a URL por canal privado.

DATABASE_PROVIDER=change-me
DATABASE_HOST=change-me.db-provider.com
DATABASE_PORT=5432
DATABASE_NAME=monolith_parking
DATABASE_WRITER_USER=parking_writer
DATABASE_READER_USER=parking_reader
DATABASE_WRITER_PASSWORD=change-me
DATABASE_READER_PASSWORD=change-me

# URL administrativa ou proprietaria do banco. Usar apenas para bootstrap e grants.
DATABASE_ADMIN_URL=postgresql://admin_user:change-me@change-me.db-provider.com:5432/monolith_parking

# URL usada por backend, API e scripts que precisam escrever.
DATABASE_URL=postgresql://parking_writer:change-me@change-me.db-provider.com:5432/monolith_parking

# URL para consultas, dashboards e integrantes que nao precisam escrever.
TEAM_READER_DATABASE_URL=postgresql://parking_reader:change-me@change-me.db-provider.com:5432/monolith_parking
PGSSLMODE=require
DB_APPLICATION_NAME=monolith-parking
DB_SCHEMA=public
