# Ambiente local padrao para qualquer pessoa que der git clone.
# Use este arquivo copiando para .env dentro de backend/database.

POSTGRES_DB=monolith_parking
POSTGRES_USER=parking
POSTGRES_PASSWORD=parking123
POSTGRES_PORT=5432
ADMINER_PORT=8080
PGSSLMODE=disable

# Para scripts rodando na maquina host, como npm run check:db.
DATABASE_URL=postgresql://parking:parking123@localhost:5432/monolith_parking

# Para backend/API/simulador rodando dentro do mesmo Docker Compose.
# Dentro da rede Docker, o host padrao e o nome do servico: postgres.
DATABASE_URL_DOCKER=postgresql://parking:parking123@postgres:5432/monolith_parking
