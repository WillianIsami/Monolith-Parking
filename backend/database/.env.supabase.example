# Ambiente compartilhado usando Supabase.
# Copie para .env e substitua os valores pelo painel do projeto Supabase.
# Nao commitar o .env real.

DATABASE_PROVIDER=supabase
DATABASE_HOST=aws-0-region.pooler.supabase.com
DATABASE_PORT=5432
DATABASE_NAME=postgres

DATABASE_WRITER_USER=parking_writer
DATABASE_READER_USER=parking_reader
DATABASE_WRITER_PASSWORD=change-me
DATABASE_READER_PASSWORD=change-me

# Use a connection string administrativa do usuario postgres do Supabase.
# No Supabase, o usuario pelo pooler geralmente segue o formato postgres.<project-ref>.
DATABASE_ADMIN_URL=postgresql://postgres.<project-ref>:<database-password>@aws-0-region.pooler.supabase.com:5432/postgres

# URLs apos rodar npm run setup:shared-access.
# No pooler do Supabase, usuarios customizados tambem usam o sufixo .<project-ref>.
DATABASE_URL=postgresql://parking_writer.<project-ref>:<writer-password>@aws-0-region.pooler.supabase.com:5432/postgres
TEAM_READER_DATABASE_URL=postgresql://parking_reader.<project-ref>:<reader-password>@aws-0-region.pooler.supabase.com:5432/postgres

PGSSLMODE=require
DB_APPLICATION_NAME=monolith-parking
DB_SCHEMA=public
