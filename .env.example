# Backend
PORT=3000
DATABASE_URL=postgresql://parking:parking123@localhost:5432/monolith_parking
PGSSLMODE=disable
MQTT_BROKER_URL=mqtt://localhost:1883
INCIDENT_CHECK_INTERVAL_MS=10000
STUCK_OCCUPIED_MINUTES=390
STUCK_FREE_MINUTES=720
FLAPPING_WINDOW_MINUTES=1
FLAPPING_THRESHOLD=5

# Simulator
SIMULATOR_PORT=4000
SIMULATED_MINUTE_MS=1000
SIMULATOR_TICK_MS=1000
GATEWAY_STATUS_INTERVAL_MS=15000

# Docker Postgres
POSTGRES_DB=monolith_parking
POSTGRES_USER=parking
POSTGRES_PASSWORD=parking123
POSTGRES_PORT=5432
ADMINER_PORT=8080
